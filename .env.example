# Copy to .env and fill in. .env is git-ignored; never commit real keys.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# low = fastest, medium/high = better answers; empty = model default
GEMINI_REASONING_EFFORT=low

# Search by meaning (Docker only): model, number of entry nodes, minimum similarity 0..1
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_TOP_K=5
VECTOR_MIN_SCORE=0.65
